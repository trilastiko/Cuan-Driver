{
  "name": "cuan-driver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cuan Driver — kokpit laba-rugi untuk driver ojol Indonesia. Cek: tekor atau cuan?",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo && node scripts/build-demo.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "e2e": "node scripts/e2e.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "hono": "^4.6.14",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "better-sqlite3": "^12.2.0",
    "playwright-core": "^1.56.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
